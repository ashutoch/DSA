{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "compile",
            "type": "process",
            "command": "${workspaceFolder}\\.vscode\\run-compile.bat",
            "args": ["${file}"],
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "compile and run",
            "type": "process",
            "command": "${workspaceFolder}\\.vscode\\run.bat",
            "args": ["${file}"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}